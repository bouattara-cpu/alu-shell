#!/usr/bin/env bash
# Init script corrigé

PID_FILE="/var/run/my_process.pid"
CMD="./manage_my_process"

case "$1" in
    start)
        $CMD &
        echo $! > "$PID_FILE"
        echo "manage_my_process started"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")"
            rm -f "$PID_FILE"
            echo "manage_my_process stopped"
        fi
        ;;
    restart)
        # On redirige la sortie vers /dev/null pour les appels stop/start internes
        $0 stop > /dev/null
        $0 start > /dev/null
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        exit 1
        ;;
esac
